{
  "name": "Fortress",
  "description": "Open-source SDK for automating web pages using natural language through AI.",
  "version": "0.38",
  "manifest_version": 3,
  "incognito": "split",
  "background": {
    "service_worker": "./lib/worker.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "debugger",
    "storage",
    "cookies",
    "https://*/*",
    "https://pipe.bytedance.net/*"
  ],
  "content_scripts": [
    {
      "js": ["./lib/browser-polyfill.js", "./lib/content.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": "icon128.png",
    "default_title": "Fortress"
  },
  "side_panel": {
    "default_path": "./pages/sidepanel.html"
  },
  "externally_connectable": {
    "matches": [
      "https://fortress.bytedance.net/*",
      "https://csp.tiktok-row.net/fortress/*",
      "http://localhost:8080/*"
    ]
  },
  "icons": {
    "128": "icon128.png"
  }
}

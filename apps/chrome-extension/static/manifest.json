{
  "name": "Fortress",
  "description": "Open-source SDK for automating web pages using natural language through AI.",
  "version": "0.68",
  "manifest_version": 3,
  "permissions": ["activeTab", "tabs", "sidePanel", "debugger", "storage"],
  "incognito": "split",
  "background": {
    "service_worker": "./scripts/worker.js"
  },
  "content_scripts": [
    {
      "js": ["./lib/browser-polyfill.js", "./lib/content.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": "icon128.png",
    "default_title": "Fortress"
  },
  "side_panel": {
    "default_path": "./index.html"
  },
  "icons": {
    "128": "icon128.png"
  }
}
